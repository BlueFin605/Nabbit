            "schema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"id\",\n    \"title\",\n    \"steps\",\n    \"version\"\n  ],\n  \"properties\": {\n    \"id\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"title\": {\n      \"const\": \"Nested Pancakes\"\n    },\n    \"steps\": {\n      \"const\": [\n        \"Prep the pan.\",\n        {\n          \"heading\": \"Batter\",\n          \"steps\": [\n            \"Mix dry.\",\n            {\n              \"heading\": \"Fold\",\n              \"steps\": [\n                \"Fold in the milk.\"\n              ]\n            }\n          ]\n        },\n        \"Serve.\"\n      ]\n    },\n    \"version\": {\n      \"type\": \"integer\",\n      \"minimum\": 1\n    }\n  }\n}"
