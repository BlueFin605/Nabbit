{
    "id": "66bbc699-b690-4c03-879b-cfcadaabb743",
    "name": "06 update recipe",
    "verb": "put",
    "protocol": "http",
    "url": "{{baseUrl}}/recipes/{{recipeId}}",
    "headers": [],
    "parameters": [],
    "body": {
        "contentType": "application/json",
        "body": "{\"title\":\"Pancakes v2\",\"servings\":6,\"ingredients\":[{\"name\":\"flour\",\"quantity\":300,\"unit\":\"g\"}],\"steps\":[\"Mix.\",\"Fry.\"],\"tags\":[\"breakfast\",\"quick\"],\"version\":{{recipeVersion}}}"
    },
    "authentication": {
        "authentication": "inherit",
        "awsSig": {
            "signUrl": false,
            "accessKey": "",
            "secretKey": "",
            "sessionToken": "",
            "awsRegion": "eu-central-1",
            "serviceName": ""
        },
        "basicAuth": {
            "userName": "",
            "password": ""
        },
        "bearerToken": {
            "token": ""
        }
    },
    "runs": [],
    "validation": {
        "type": "Body",
        "headers": [],
        "body": "JsonSchema",
        "httpCode": 200,
        "jsonSchema": {
            "schema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"id\",\n    \"title\",\n    \"servings\",\n    \"ingredients\",\n    \"steps\",\n    \"tags\",\n    \"version\",\n    \"createdAt\",\n    \"updatedAt\"\n  ],\n  \"properties\": {\n    \"id\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"title\": {\n      \"const\": \"Pancakes v2\"\n    },\n    \"servings\": {\n      \"const\": 6\n    },\n    \"ingredients\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"id\",\n          \"name\",\n          \"unit\",\n          \"scalable\"\n        ],\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"unit\": {\n            \"type\": \"string\"\n          },\n          \"scalable\": {\n            \"type\": \"boolean\"\n          },\n          \"quantity\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          }\n        }\n      }\n    },\n    \"steps\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"tags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"version\": {\n      \"const\": 2\n    },\n    \"createdAt\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"updatedAt\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    }\n  }\n}"
        }
    },
    "capture": [
        {
            "variable": "recipeVersion",
            "from": "body",
            "path": "$.version",
            "id": "cc335896-c794-4919-b644-3fac7ff66024"
        }
    ]
}