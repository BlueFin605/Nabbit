    "validation": {
        "type": "Body",
        "headers": [],
        "body": "JsonSchema",
        "httpCode": 200,
        "jsonSchema": {
            "schema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"id\",\n    \"title\",\n    \"version\",\n    \"scaleBy\",\n    \"originalSize\"\n  ],\n  \"properties\": {\n    \"id\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"title\": {\n      \"const\": \"Scaled Pancakes\"\n    },\n    \"scaleBy\": {\n      \"const\": \"ing-milk\"\n    },\n    \"ingredients\": {\n      \"type\": \"array\",\n      \"minItems\": 2,\n      \"maxItems\": 2,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"id\",\n          \"name\",\n          \"unit\",\n          \"scalable\"\n        ],\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"unit\": {\n            \"type\": \"string\"\n          },\n          \"scalable\": {\n            \"type\": \"boolean\"\n          },\n          \"quantity\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          }\n        }\n      }\n    },\n    \"version\": {\n      \"const\": 2\n    },\n    \"originalSize\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"servings\",\n        \"ingredients\"\n      ],\n      \"properties\": {\n        \"servings\": {\n          \"const\": 2\n        },\n        \"ingredients\": {\n          \"type\": \"array\",\n          \"minItems\": 2,\n          \"maxItems\": 2,\n          \"items\": {\n            \"type\": \"object\",\n            \"required\": [\n              \"id\",\n              \"name\",\n              \"unit\",\n              \"scalable\"\n            ],\n            \"properties\": {\n              \"id\": {\n                \"type\": \"string\"\n              },\n              \"name\": {\n                \"type\": \"string\"\n              },\n              \"unit\": {\n                \"type\": \"string\"\n              },\n              \"scalable\": {\n                \"type\": \"boolean\"\n              },\n              \"quantity\": {\n                \"type\": [\n                  \"number\",\n                  \"null\"\n                ]\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"
        }
    }
