            "schema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"imageKey\",\n    \"url\",\n    \"fields\",\n    \"expiresIn\"\n  ],\n  \"properties\": {\n    \"imageKey\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[^/]+/[^/]+\\\\.png$\"\n    },\n    \"url\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"fields\": {\n      \"type\": \"object\"\n    },\n    \"expiresIn\": {\n      \"const\": 300\n    }\n  }\n}"
