            "schema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"draft\"\n  ],\n  \"properties\": {\n    \"draft\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"recipe\"\n      ],\n      \"properties\": {\n        \"confidence\": {\n          \"type\": \"string\"\n        },\n        \"recipe\": {\n          \"type\": \"object\",\n          \"required\": [\n            \"title\",\n            \"servings\",\n            \"ingredients\",\n            \"steps\",\n            \"tags\"\n          ],\n          \"properties\": {\n            \"title\": {\n              \"const\": \"Pancakes\"\n            },\n            \"ingredients\": {\n              \"type\": \"array\",\n              \"minItems\": 3,\n              \"maxItems\": 3\n            },\n            \"steps\": {\n              \"type\": \"array\",\n              \"minItems\": 2,\n              \"maxItems\": 2\n            }\n          }\n        }\n      }\n    }\n  }\n}"
