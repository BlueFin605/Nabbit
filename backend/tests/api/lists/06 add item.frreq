{
    "id": "3a8ccf3e-135c-4215-b542-abaae7f0ff16",
    "name": "06 add item",
    "verb": "post",
    "protocol": "http",
    "url": "{{baseUrl}}/lists/{{listId}}/items",
    "headers": [],
    "parameters": [],
    "body": {
        "contentType": "application/json",
        "body": "{\"name\":\"Milk\",\"category\":\"Dairy\"}"
    },
    "authentication": {
