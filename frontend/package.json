    "@nabbit/recipe-core": "^0.0.0",
    "amazon-cognito-identity-js": "^6.3.16",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "angular-eslint": "22.5.0",
